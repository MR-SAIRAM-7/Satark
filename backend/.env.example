# Copy to backend/.env. Every value is optional: with none set the API runs in
# demo mode on an embedded MongoDB (backend/.data), seeds demo data on first
# start, and records WhatsApp/push messages in the outbox instead of sending.

PORT=8000
LOG_LEVEL=info
# The https address Twilio can reach this API on (deployment or tunnel). Twilio signs webhooks
# with this exact URL and downloads the Complaint Kit PDF from it, so localhost only works in demo mode.
PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# MongoDB Atlas. Empty = embedded MongoDB persisted to backend/.data/mongo.
MONGODB_URI=

# Required in production (any long random strings).
JWT_SECRET=
HASH_SECRET=
PHONE_ENC_KEY=

# Demo mode: OTP is DEMO_OTP, 1930 / portal actions stay on mock screens.
DEMO_MODE=true
DEMO_OTP=123456
SEED_ON_START=true
# Synthetic scam traffic every 10-25 s for the dashboard (also a toggle on the dashboard).
LIVE_FEED=false
JOBS_ENABLED=true
ESCALATE_AFTER_MIN=5
# RDAP domain-age lookups for links (rule R5).
ENRICH_LINKS=true

# Layer 4 LLM chain: Gemini -> OpenRouter -> Sarvam-105B (first configured wins).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# Sarvam: Sarvam-105B, Bulbul (TTS), Saaras (STT), Mayura (translation).
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_STT_MODEL=saaras:v3
SARVAM_TRANSLATE_MODEL=mayura:v1

# Rule R6.
GOOGLE_SAFE_BROWSING_API_KEY=

# Twilio: WhatsApp (sandbox number during the hackathon) and Verify for sign-in codes.
# Setup steps: docs/TWILIO.md. Check the result with: npm run twilio:check --workspace backend
# Account SID and Auth Token are on the Twilio console home page, under Account Info.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The WhatsApp Sandbox number is the same for everyone. Replace it once you register your own sender.
TWILIO_WHATSAPP_FROM=+14155238886
# Only needed for real sign-in codes (DEMO_MODE=false). Twilio console > Verify > Services.
TWILIO_VERIFY_SERVICE_SID=

# Expo push (optional access token; push works without one).
EXPO_ACCESS_TOKEN=

# AWS S3 for Complaint Kits. Empty = local disk behind signed, expiring links.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# Chrome or Edge for PDF rendering. Found automatically on Windows, macOS and Debian.
CHROME_PATH=
