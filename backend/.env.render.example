# Provider keys for the API on Render.
#
# How to use: copy this file, fill in the values you have, delete the lines you
# leave empty, then paste the result into
#   Render dashboard > satark-api > Environment > Add from .env
# Do not commit a filled-in copy. Every key here is optional: without one, that
# feature falls back (rules + ML verdicts, phone's own voice, outbox instead of WhatsApp).
#
# Not listed, because render.yaml already sets them:
#   MONGODB_URI (asked for when the Blueprint is created)
#   JWT_SECRET, HASH_SECRET, PHONE_ENC_KEY (generated by Render)
#   PUBLIC_BASE_URL (taken from Render's RENDER_EXTERNAL_URL)
#   ALLOWED_ORIGINS, DEMO_MODE, SEED_ON_START, TWILIO_WHATSAPP_FROM, GEMINI_MODEL

# Layer 4 AI analyst: Gemini first, OpenRouter second, Sarvam third.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Sarvam: Indian-language reasoning, voice (Bulbul), speech to text (Saaras), translation (Mayura).
SARVAM_API_KEY=

# Twilio: WhatsApp delivery and the "forward to Satark" bot. Twilio console > Account Info.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Only for real SMS sign-in codes (DEMO_MODE=false).
TWILIO_VERIFY_SERVICE_SID=

# Rule R6: known-dangerous links.
GOOGLE_SAFE_BROWSING_API_KEY=

# Complaint Kit PDFs on S3. Without these they are kept on the container's disk,
# which Render wipes on every restart (links expire after 10 minutes anyway).
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
