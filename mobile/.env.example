# Copy to .env (git-ignored). All values are optional: with none set, the app
# runs on the on-device engine and demo data.

# Backend base URL including /v1. When set, analysis, voice, complaints and
# WhatsApp delivery all go through the backend.
EXPO_PUBLIC_API_BASE_URL=

# --- Demo-only direct provider access (before the backend exists) -----------
# These are bundled into the app. Use restricted, throwaway keys and remove
# them once EXPO_PUBLIC_API_BASE_URL is set.
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_MODEL=gemini-flash-latest
EXPO_PUBLIC_OPENROUTER_API_KEY=
EXPO_PUBLIC_OPENROUTER_MODEL=google/gemini-2.5-flash
EXPO_PUBLIC_SARVAM_API_KEY=
EXPO_PUBLIC_SARVAM_CHAT_MODEL=sarvam-105b
EXPO_PUBLIC_SARVAM_TTS_MODEL=bulbul:v3
EXPO_PUBLIC_SARVAM_TTS_SPEAKER=shubh
EXPO_PUBLIC_SARVAM_STT_MODEL=saaras:v3

# Twilio WhatsApp sender the "forward to Satark" bot answers on.
EXPO_PUBLIC_WHATSAPP_BOT_NUMBER=+14155238886
